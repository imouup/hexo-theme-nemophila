<%
    const counterService = theme.counter && theme.counter.service === 'nanocount' ? 'nanocount' : 'vercount';
    const counterServer = counterService === 'nanocount' && theme.counter.server
        ? String(theme.counter.server).replace(/\/+$/, '')
        : '';
%>
<head>
    <title>
        <% if (is_post()) { %>
            <%= page.title %> | <%= config.title %>
        <% } else if (is_home()) { %>
            <%= config.title ? config.title : 'Nemophila' %>
        <% } else if (is_category()) { %>
            <%= page.category %> | <%= config.title %>
        <% } else { %>
            <%= page.title %> | <%= config.title %>
        <% } %>
        
    </title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <link rel="icon" href="<%= url_for('ico/Nemo.svg')  %>" />
    <%- css('css/style.css') %>
    <%- css('css/all.min.css') %>
    <!-- ASCII-painting -->
    <%- js('js/nya.js') %>
    <!-- 引入Noto系和非斜体的Cormorant Garamond字体 -->
    <%- js('js/getfonts.js') %>
    <!-- 引入LaTex支持css -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.css">
    <!-- 引入APlayer支持css和js -->
    <%- css('css/APlayer.min.css')  %>
    <%- js('js/APlayer.min.js')  %>
    <!-- 引入Metingjs -->
    <script src="https://cdn.jsdelivr.net/npm/meting@2/dist/Meting.min.js"></script>
    <!-- 引入Linking -->
    <%- js('js/linking.js') %>
    <!-- 引入访问量计数器 -->
    <% if (counterService !== 'nanocount') { %>
        <script defer src="https://events.vercount.one/js"></script>
    <% } %>
    <script>
        let HEXO_SETTINGS = {
            root: "<%- config.root %>", 
            url: "<%- config.url %>",
            author: "<%- config.author %>"
        };

        let Nemophila = {
            version: "0.3.1"
        };

        let THEME_SETTINGS = {
            lazyload: {
                enable: <%- theme.lazyload && theme.lazyload.enable ? 'true' : 'false' %>,
                loading_img: "<%- theme.lazyload && theme.lazyload.loading_img ? theme.lazyload.loading_img : '/images/yachiyo_loading_640.webp' %>"
            },
            counter: {
                service: <%- JSON.stringify(counterService) %>,
                server: <%- JSON.stringify(counterServer) %>
            }
        };

        const normalizeNanocountPath = (path) => {
            const normalized = path.replace(/\/+$/, '');
            return normalized || '/';
        };

        window.NEMOPHILA_COUNTER = {
            getPageViews: async (url) => {
                const counter = THEME_SETTINGS.counter;
                let endpoint;
                if (counter.service === 'nanocount') {
                    const target = new URL(url, window.location.href);
                    const query = new URLSearchParams({
                        host: target.hostname,
                        path: normalizeNanocountPath(target.pathname)
                    });
                    endpoint = counter.server + '/api/v1/count?' + query;
                } else {
                    endpoint = 'https://events.vercount.one/api/v2/log?url=' + encodeURIComponent(url);
                }
                const response = await fetch(endpoint);
                if (!response.ok) throw new Error('Counter request failed');
                const payload = await response.json();
                const data = payload && payload.data;
                const views = counter.service === 'nanocount' ? data && data.pageViews : data && data.page_pv;
                if (views === undefined || views === null) throw new Error('Invalid counter response');
                return views;
            }
        };

        if (THEME_SETTINGS.counter.service === 'nanocount') {
            document.addEventListener('DOMContentLoaded', async () => {
                try {
                    const response = await fetch(THEME_SETTINGS.counter.server + '/api/v1/hit', {
                        method: 'POST',
                        body: JSON.stringify({
                            host: window.location.hostname,
                            path: normalizeNanocountPath(window.location.pathname)
                        }),
                        credentials: 'omit',
                        mode: 'cors',
                        keepalive: true
                    });
                    if (!response.ok) throw new Error('Counter request failed');
                    const payload = await response.json();
                    const views = payload && payload.data && payload.data.pageViews;
                    if (views === undefined || views === null) throw new Error('Invalid counter response');
                    document.querySelectorAll('[data-nanocount-page]').forEach((node) => {
                        node.textContent = Number(views).toLocaleString();
                    });
                } catch (error) {
                    console.error('Error updating view count:', error);
                }
            });
        }
    </script>
</head>
