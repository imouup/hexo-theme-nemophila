 <% 
    let navtheme = className || '';
 %>

<nav class="navbar <%= navtheme %>">
    <a href="<%- url_for('/') %>" style="text-decoration: none;">
        <h1 class="title <%= navtheme %>"><%= theme.title ? theme.title : 'Nemophila' %></h1> 
    </a>
    <div class="navlink <%= navtheme %>">
        <% for (let link in theme.menu) { %>
            <div class="nav-item-container <%= navtheme %>">
                <a href="<%- theme.menu[link].path ? url_for(theme.menu[link].path) : 'javascript:void(0)' %>" class="navlink-item <%= navtheme %>">
                    <div class="nav-icon <%= navtheme %>" 
                        style="-webkit-mask-image: url('<%- url_for(theme.menu[link].icon) %>'); mask-image: url('<%- url_for(theme.menu[link].icon) %>');">
                     </div>
                    <span><%= link %></span>
                    
                    <% if (theme.menu[link].submenu) { %>
                        <i class="fa-solid fa-angle-down fa"></i>
                    <% } %>

                </a>
                
                <% if (theme.menu[link].submenu) { %>
                    <div class="nav-item-submenu <%= navtheme %>">
                        <% for (let sublink in theme.menu[link].submenu) { %>
                            <% let path = ""; %>
                            <% let item = theme.menu[link].submenu[sublink]; %>
                            <% if (item.type === 'page') { %>
                                <% path = url_for(item.path); %>
                            <% } else if (item.type === 'link') { %>
                                <% path = item.path; %>
                            <% } %>
                            <a href="<%= path %>">
                                <% if (item.icon) {%>
                                    <i class="<%= item.icon %>" style="transform: translateY(15%); font-size: 14px;"></i>
                                <% } %>
                                <span data-content="<%= sublink %>"><%= sublink %></span>
                                
                            </a>
                        <% } %>
                    </div>
                <% } %>

            </div>
        <% } %>
        <a href="<%- url_for(theme.rss.path) %>" class="navlink-rss <%= navtheme %>">
            <div class="nav-icon <%= navtheme %>" 
                style="-webkit-mask-image: url('<%- url_for(theme.rss.icon) %>'); mask-image: url('<%- url_for(theme.rss.icon) %>');">
            </div>
        </a>
    </div>
    <a href="<%- url_for('search') %>" class="search <%= navtheme %>">
        <div class="nav-icon <%= navtheme %>" 
            style="-webkit-mask-image: url('<%- url_for('ico/navbar/search.svg') %>'); mask-image: url('<%- url_for('ico/navbar/search.svg') %>');">
        </div>
    </a>
    
</nav>

<nav class="navbar-m">
    <a class="nav-menu"></a>
    <div class="nav-right">
        <a class="title-m" href="/"><%= theme.title ? theme.title : 'Nemophila' %></a>
        <a class="search-m" href="/search"></a>
    </div>
    <div class="navbar-submenu-bgcover"></div>
    <div class="navbar-submenu">
        <div class="navbar-submenu-close"></div>
        <a href="/about" style="text-decoration: none;">
            <img class="navbar-submenu-avatar" src="<%- url_for(theme.aboutme.avatar) %>" alt="avatar">            
        </a>
        <a href="/about" class="navbar-submenu-name_mo"><%= config.author_name_in_mother_tongue %></a>
        <a href="/about" class="navbar-submenu-name">@ <%= config.author %></a>
    
        <span class="navbar-submenu-contact">
            <% for (let name in theme.contact) { %>
                <% let item = theme.contact[name]; %>
                <a href="<%- url_for(item.path) %>" title="<%= name %>" class="contact-item">
                    <% if (item.icon && (item.icon.includes('/') || item.icon.includes('.'))) { %>
                        <img src="<%- url_for(item.icon) %>" alt="<%= name %>" class="contact-icon" draggable="false">
                    <% } else { %>
                        <i class="<%= item.icon %> contact-icon"></i>
                    <% } %>
                </a>
            <% } %>
        </span>

        <section class="navbar-submenus">
            <% for (let link in theme.menu) { %>
                <div class="navbar-submenu-item-container">
                    <a href="<%- theme.menu[link].path ? url_for(theme.menu[link].path) : 'javascript:void(0)' %>">
                        <div class="nav-icon" style="-webkit-mask-image: url('<%- url_for(theme.menu[link].icon) %>'); mask-image: url('<%- url_for(theme.menu[link].icon) %>');"></div>
                        <span><%= link %></span>
                    </a>
                    <% if (theme.menu[link].submenu) { %>
                        <div class="navbar-submenu-child">
                            <% for (let sublink in theme.menu[link].submenu) { %>
                                <% let path = ""; %>
                                <% let item = theme.menu[link].submenu[sublink]; %>
                                <% if (item.type === 'page') { %>
                                    <% path = url_for(item.path); %>
                                <% } else if (item.type === 'link') { %>
                                    <% path = item.path; %>
                                <% } %>
                                <a href="<%= path %>">
                                    <% if (item.icon) {%>
                                        <i class="<%= item.icon %>"></i>
                                    <% } %>
                                    <span><%= sublink %></span>
                                </a>
                            <% } %>
                        </div>
                    <% } %>
                </div>
            <% } %>
        </section>
        <a class="navbar-submenu-aboutme" href="<%- url_for(theme.aboutme.path) %>">
        About me
        </a>
    
    
    </div>
</nav>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const navMenu = document.querySelector('.nav-menu');
        const navSubmenu = document.querySelector('.navbar-submenu');
        const navSubmenuBgcover = document.querySelector('.navbar-submenu-bgcover');
        const navSubmenuClose = document.querySelector('.navbar-submenu-close');

        function openSubmenu() {
            navSubmenu.classList.add('active');
            navSubmenuBgcover.classList.add('active');
        }

        function closeSubmenu() {
            navSubmenu.classList.remove('active');
            navSubmenuBgcover.classList.remove('active');
        }

        navMenu.addEventListener('click', openSubmenu);
        navSubmenuBgcover.addEventListener('click', closeSubmenu);
        navSubmenuClose.addEventListener('click', closeSubmenu);

    })

</script>