:root{
  // 主题色
  --base: #6C9AE4;
  --secondary: #C7D0F5;
  --text: #14171F;
  --highlight: #FCF5B0;
  --windy: #F0FAFF;
  --bg: rgb(205, 216, 232);
  --white: #FFFFFF;
  --text2: rgb(47, 82, 132);
  --text3: #375DB3;
  --pagetitle: #223D78;
  --codeblock: hsla(199, 69%, 87%, 0.3);

  // 组件补充色
  --text-strong: #000;
  --nav-icon-color: rgb(59, 59, 59);
  --nav-panel-bg: rgba(246, 253, 255, 0.6);
  --text-muted: #A2B0C3;

  // 阴影与半透明底色
  --shadow-ambient: rgba(205, 216, 232, 0.45);
  --shadow-ambient-strong: rgba(205, 216, 232, 0.6);
  --shadow-ambient-soft: rgba(205, 216, 232, 0.25);
  --shadow-ambient-solid: rgba(205, 216, 232, 1);
  --shadow-surface: rgba(54, 54, 54, 0.45);
  --shadow-white-soft: rgba(230, 233, 238, 0.75);
  --shadow-white: rgba(255, 255, 255, 1.0);
  --shadow-white-border: rgba(255, 255, 255, 0.8);
  --overlay-music: rgba(47, 62, 75, 0.5);
  --overlay-card-medium: rgba(255, 255, 255, 0.75);
  --overlay-card-soft: rgba(255, 255, 255, 0.5);
  --overlay-track: rgba(196, 196, 196, 0.15);
  --overlay-buffer: rgba(141, 144, 148, 0.25);
  --overlay-buffer-strong: rgba(141, 144, 148, 0.6);
  --overlay-black-soft: rgba(0, 0, 0, 0.2);
  --overlay-black-faint: rgba(0, 0, 0, 0.1);
  --nav-hover-shadow: rgba(73, 73, 73, 0.2);
  --nav-submenu-shadow: rgba(58, 58, 58, 0.2);
  --search-hover-bg: rgba(205, 216, 232, 0.2);
  --search-focus-border: rgba(47, 82, 132, 0.75);
 
  --title: 32px;
  --h1: 36px;
  --h2: 24px;
  --h3: 16px;
  --tx: 16px;
}

